# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NODAK Security & Database
JWT_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET"
DATABASE_PATH="./nodak.db"

# Payment Gateway (Stripe / Spotify-style Checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AWS Cloud & IAM Enforcement Configuration
AWS_REGION="us-east-1"
AWS_ACCOUNT_ID="849201749201"
AWS_IAM_ENFORCEMENT_MODE="STRICT_AUTO_DENY"

# Google OAuth 2.0 API (Sign In & Workspace Sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Outlook / Entra ID OAuth 2.0 API (Sign In & Graph Sync)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
